{
  "name": "awesome-readme",
  "version": "0.0.8",
  "description": "Build awesome readme easily",
  "bin": {
    "awesome-readme": "dist/index.js"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "types": "dist/index.d.ts",
  "browser": "./standalone.js",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "awesome-readme": "node ./dist/index.js",
    "lint": "eslint --no-error-on-unmatched-pattern 'src/**/*.js'",
    "typecheck": "tsc --noEmit",
    "lint:fix": "prettier --write \"src/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\"",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-aurele-besner/awesome-readme.git"
  },
  "keywords": [
    "readme-generator",
    "readme",
    "readme-builder"
  ],
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "author": "Marc-Aurele Besner <82244926+marc-aurele-besner@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marc-aurele-besner/awesome-readme/issues"
  },
  "homepage": "https://github.com/marc-aurele-besner/awesome-readme#readme",
  "dependencies": {
    "fs": "^0.0.1-security"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/eslint": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^7.0.0"
  }
}
